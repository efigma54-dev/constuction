# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is listed in .gitignore.

# Canonical site URL used for sitemap.xml and robots.txt.
# In development: http://localhost:3000
# In production:  https://constuction-eosin.vercel.app
NEXT_PUBLIC_SITE_URL=https://constuction-eosin.vercel.app

# Supabase — required for Contact form submissions.
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
